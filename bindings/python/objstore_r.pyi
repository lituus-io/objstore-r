"""One object-store API over Google Cloud Storage, a local directory and memory."""

from collections.abc import Buffer
from os import PathLike
from typing import Literal, final

__version__: str
MAX_INFLATED_BYTES: int

class ObjstoreError(Exception): ...
class NotFoundError(ObjstoreError): ...
class ConflictError(ObjstoreError): ...
class PreconditionFailedError(ObjstoreError): ...
class InvalidKeyError(ObjstoreError): ...
class UnavailableError(ObjstoreError): ...
class AuthError(ObjstoreError): ...
class TooLargeError(ObjstoreError): ...
class ProtocolError(ObjstoreError): ...
class EncodedRangeError(ObjstoreError): ...
class UnsupportedEncodingError(ObjstoreError): ...
class ChangedError(ObjstoreError): ...

@final
class Blob(Buffer):
    """Object bytes shared with the backend buffer; `memoryview(blob)` is zero-copy."""
    @property
    def generation(self) -> int | None: ...
    def __len__(self) -> int: ...
    def __bytes__(self) -> bytes: ...
    def to_bytes(self) -> bytes: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Meta:
    @property
    def key(self) -> str: ...
    @property
    def size(self) -> int: ...
    @property
    def generation(self) -> int: ...
    @property
    def content_encoding(self) -> Literal["gzip"] | None: ...

@final
class Store:
    @staticmethod
    def memory(*, max_inflated: int = 1 << 30) -> Store: ...
    @staticmethod
    def local(root: str | PathLike[str], *, max_inflated: int = 1 << 30) -> Store: ...
    @staticmethod
    def gcs(
        bucket: str,
        *,
        token: str | None = None,
        anonymous: bool = False,
        endpoint: str | None = None,
        connect_timeout: float = 10.0,
        request_timeout: float = 30.0,
        idle_timeout: float = 60.0,
        min_throughput: int = 64 << 10,
        max_retries: int = 5,
        max_object_bytes: int = 4 << 30,
        resumable_threshold: int = 8 << 20,
        upload_chunk: int = 8 << 20,
        max_inflated: int = 1 << 30,
        timeout: float | None = None,
    ) -> Store: ...
    @property
    def kind(self) -> str: ...
    def get(self, key: str) -> Blob | None: ...
    def get_range(self, key: str, start: int, end: int) -> Blob: ...
    def get_many(self, keys: list[str]) -> list[Blob | None]: ...
    def head(self, key: str) -> Meta | None: ...
    def put(
        self,
        key: str,
        data: Buffer | Blob,
        *,
        if_generation: int | None = None,
        create_only: bool = False,
        content_encoding: Literal["gzip", "identity"] | None = None,
    ) -> int: ...
    def list(self, prefix: str = "") -> list[Meta]: ...
    def delete(self, key: str) -> None: ...
    def inject_failure(self, *, after: int = 0, lost_response: bool = False) -> None: ...

def check_key(key: str) -> None: ...
